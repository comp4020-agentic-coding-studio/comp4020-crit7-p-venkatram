---
import Base from "../../layouts/Base.astro";
import { getStudentId } from "../../lib/auth";
import { TOPICS } from "../../lib/community";
import { communityCounts, joinedTopicsFor } from "../../lib/db";

const studentId = getStudentId(Astro.cookies);
const counts = communityCounts();
const joined = studentId ? joinedTopicsFor(studentId) : new Set<string>();
---

<Base title="Community — Career Central">
  <div class="prose">
  <h1>Community</h1>
  <p>
    Job hunting and contract questions feel like something you're figuring
    out alone — even though the people sitting next to you in a lecture are
    almost certainly stuck on the exact same thing.
  </p>
  <p>
    Community here is a show of hands, not a public board: join a topic and
    you'll show up as one of the students interested in it, with no free
    text and nothing to moderate.
  </p>

  {
    !studentId && (
      <p>
        <a href="/login?next=/community/">Log in with your student ID</a> to
        join a topic.
      </p>
    )
  }
  </div>

  <ul class="topic-list">
    {
      Object.entries(TOPICS).map(([key, label]) => {
        const count = counts[key as keyof typeof TOPICS] ?? 0;
        const isJoined = joined.has(key);
        return (
          <li>
            <div class="topic-row">
              <span class="topic-label">{label}</span>
              <span class="topic-count">
                {count} {count === 1 ? "student" : "students"} interested
              </span>
            </div>
            {studentId && (
              <form method="post" action="/api/community">
                <input type="hidden" name="topic" value={key} />
                <input type="hidden" name="action" value={isJoined ? "leave" : "join"} />
                <button type="submit" class={isJoined ? "joined" : ""}>
                  {isJoined ? "You're in — leave" : "I'm interested"}
                </button>
              </form>
            )}
          </li>
        );
      })
    }
  </ul>

  <div class="prose">
  <h2>Where ANU's peer communities already live</h2>
  <p>
    This page only measures interest — for actual discussion and events,
    ANU's existing student spaces are the real thing, not a page like this
    one.
  </p>
  <p>Start with these, already running:</p>
  <ul>
    <li>
      <a href="https://anusa.au/life/clublist/" target="_blank" rel="noopener noreferrer">
        ANUSA clubs &amp; societies ↗
      </a> — over 110 clubs across discipline, culture, arts and special interest.
    </li>
    <li>
      <a href="https://careerhub.anu.edu.au/" target="_blank" rel="noopener noreferrer">
        ANU CareerHub ↗
      </a> — workshops, info sessions and careers fairs where students actually meet in person.
    </li>
  </ul>
  </div>
</Base>
